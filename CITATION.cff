title: "RSDTK: Remote Sensing Data Toolkit"
message: "If you use this software, please cite it using the metadata from this file."
type: software
authors:
  - given-names: "Daniel B."
    family-names: Williams
    orcid: "https://orcid.org/0000-0003-4027-8544"
    email: "dbwilliams@pitt.edu"
    affiliation: "Department of Geology & Environmental Science, University of Pittsburgh"
